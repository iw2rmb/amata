{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "step.roadmap.schema.json",
  "title": "Roadmap Step",
  "description": "Schema definition for a single roadmap item.",
  "$defs": {
    "done": {
      "type": "boolean",
      "default": false,
      "$comment": "Do **NOT** edit it manually. It will be `true` automatically if no new gaps identified on review."
    },
    "reasoning": {
      "type": "string",
      "enum": ["low", "medium", "high", "xhigh"],
      "$comment": "Estimated by COSMIC FP (COSMIC Functional Points, CFP) implementation effort tier."
    },
    "item": {
      "$comment": "Implementation step. Avoid ambiguity: step must identify concrete files/modules and expected observable outcomes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "done",
        "reviews",
        "label",
        "summary",
        "classification",
        "components",
        "implementation",
        "verification",
        "reasoning",
        "cfp"
      ],
      "properties": {
        "commit": {
          "$ref": "./common.roadmap.schema.json#/$defs/commit"
        },
        "done": {
          "$ref": "#/$defs/done"
        },
        "reviews": {
          "$ref": "./common.roadmap.schema.json#/$defs/reviews"
        },
        "label": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)*$",
          "$comment": "Roadmap numbering label, e.g. 1.5a is not allowed by template, 1.5 is allowed.",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "$comment": "One-line scope summary for this item; this summary field is the only place where semantic/content changes are allowed."
        },
        "classification": {
          "type": "string",
          "enum": ["determined", "assumption-bound"],
          "$comment": "`determined`: all involved components/classes/functions/structs are known. `assumption-bound`: unresolved unknowns remain."
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "$comment": "Closed, exhaustive file list for this item only: relative file paths only (no globs/directories). This list defines the edit boundary and must be disjoint across items (a file may appear in only one item).",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*[{}*])(?!.*\\s)(?!.*//$)(?!.*\\/\\/$)(?!.*\\/\\*$)(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
          }
        },
        "assumptions": {
          "type": "string",
          "minLength": 1,
          "$comment": "Required only for assumption-bound items; omit for determined items."
        },
        "baseline": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*[{}*])(?!.*\\s)(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
          },
          "$comment": "Existing files/modules whose mechanisms must be reused or refactored."
        },
        "delta": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\[(replace|canonical_with_compat|additive)\\]\\s(?!.*\\b(canonical|compat|shim|fallback|deprecat|remove|drop|migrate)\\b(?!.*\\[canonical_with_compat\\]|.*\\[replace\\])).+\\s->\\s.+$",
            "$comment": "[replace]: old path removed in this step, and only new path is accepted; [canonical_with_compat]: new path is default/canonical, and old path remains accepted as compatibility shim; [additive]: new path added, and old/default/canonical path does not change in this step",
            "allOf": [
              {
                "pattern": "^\\[(replace|canonical_with_compat|additive)\\]\\s.+\\s->\\s.+$"
              },
              {
                "if": { "pattern": "^\\[additive\\]\\s" },
                "then": {
                  "not": {
                    "pattern": "\\b(canonical|default|primary|ownership switch)\\b"
                  }
                }
              }
            ]
          },
          "$comment": "Behavior-only changes from baseline, formatted as 'from -> to'."
        },
        "implementation": {
          "type": "array",
          "minItems": 1,
          "$comment": "Keep all functional actions inside one item at the same detail level. Must only describe actions that realize `summary` inside `components`.",
          "items": {
            "type": "string",
            "minLength": 1,
            "$comment": "Functional actions at class/function/struct level."
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "$comment": "One-line verification scenarios. Must include at least one parity check proving adjacent behavior is unchanged (do not add `Parity check:` prefix)."
        },
        "reasoning": {
          "$ref": "#/$defs/reasoning"
        },
        "cfp": {
          "type": "integer",
          "minimum": 1,
          "$comment": "Calculated COSMIC FP"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "assumption-bound"
              }
            }
          },
          "then": {
            "required": ["assumptions"],
            "not": {
              "anyOf": [{ "required": ["baseline"] }, { "required": ["delta"] }]
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "determined"
              }
            }
          },
          "then": {
            "not": {
              "required": ["assumptions"]
            },
            "required": ["baseline", "delta"],
            "properties": {
              "components": {
                "items": {
                  "allOf": [
                    { "not": { "pattern": "\\*\\*" } },
                    { "not": { "pattern": "\\*" } },
                    { "not": { "pattern": "[{}]" } }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "done": {
                "const": true
              }
            },
            "required": ["done"]
          },
          "then": {
            "required": ["commit"],
            "properties": {
              "reviews": {
                "not": {
                  "contains": {
                    "type": "object",
                    "not": {
                      "required": ["commit"]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cfp": {
                "minimum": 1,
                "maximum": 3
              }
            },
            "required": ["cfp"]
          },
          "then": {
            "properties": {
              "reasoning": {
                "const": "low"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cfp": {
                "minimum": 4,
                "maximum": 8
              }
            },
            "required": ["cfp"]
          },
          "then": {
            "properties": {
              "reasoning": {
                "const": "medium"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cfp": {
                "minimum": 9,
                "maximum": 16
              }
            },
            "required": ["cfp"]
          },
          "then": {
            "properties": {
              "reasoning": {
                "const": "high"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cfp": {
                "minimum": 17
              }
            },
            "required": ["cfp"]
          },
          "then": {
            "properties": {
              "reasoning": {
                "const": "xhigh"
              }
            }
          }
        }
      ]
    }
  }
}
