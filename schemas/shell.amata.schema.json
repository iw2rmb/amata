{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$default": "command",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "shell"
    },
    "when": true,
    "expect": true,
    "response": {
      "$ref": "common.response-config.amata.schema.json"
    },
    "stall": {
      "$ref": "common.stall.amata.schema.json"
    },
    "command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.string-or-expr.amata.schema.json"
          }
        }
      ]
    },
    "cwd": {
      "$ref": "common.string-or-expr.amata.schema.json"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.string-or-expr.amata.schema.json"
      }
    }
  },
  "required": [
    "command"
  ],
  "additionalProperties": false,
  "$defs": {
    "defaultValue": {
      "$ref": "shell.value.amata.schema.json"
    }
  }
}
