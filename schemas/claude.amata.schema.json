{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "claude"
    },
    "when": true,
    "expect": true,
    "response": {
      "$ref": "common.response-config.amata.schema.json"
    },
    "stall": {
      "$ref": "common.stall.amata.schema.json"
    },
    "prompt": {
      "$ref": "common.string-or-expr.amata.schema.json"
    },
    "model": {
      "$ref": "common.string-or-expr.amata.schema.json"
    },
    "reasoning": {
      "$ref": "common.string-or-expr.amata.schema.json"
    },
    "cwd": {
      "$ref": "common.string-or-expr.amata.schema.json"
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.string-or-expr.amata.schema.json"
      }
    }
  },
  "required": [
    "type",
    "prompt"
  ],
  "additionalProperties": false
}
