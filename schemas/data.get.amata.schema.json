{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$default": "file",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "data.get"
    },
    "when": true,
    "expect": true,
    "response": {
      "$ref": "common.response-config.amata.schema.json"
    },
    "stall": {
      "$ref": "common.stall.amata.schema.json"
    },
    "file": {
      "$ref": "common.string-or-expr.amata.schema.json"
    },
    "format": {
      "$ref": "common.string-or-expr.amata.schema.json"
    },
    "query": {
      "$ref": "common.string-or-expr.amata.schema.json"
    },
    "default": true,
    "cwd": {
      "$ref": "common.string-or-expr.amata.schema.json"
    }
  },
  "required": [
    "type",
    "file"
  ],
  "additionalProperties": false
}
