{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$default": "cases",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "switch"
    },
    "when": true,
    "expect": true,
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "when": true,
          "steps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "type",
    "cases"
  ],
  "additionalProperties": false
}
